# Dependencies — reinstalled by `npm install`, never committed.
node_modules/

# Build output — GitHub Actions builds this fresh on every push.
dist/
dist-ssr/
.vite/

# Secrets — never commit these.
.env
.env.*
!.env.example

# Local deploy scripts (superseded by the GitHub Actions workflow).
deploy.py
deploy_root.py

# Original full-resolution photo library (~68 MB). Kept out of the repo so clones stay
# fast; the web-ready versions live in website/public/assets.
#
# The leading slash matters: these MUST be anchored to the repo root. Without it the
# pattern matches at any depth, and because Git is case-insensitive on Windows/macOS,
# "Cards/" would also swallow website/public/assets/cards/ — which silently dropped the
# Vault card images from the repo and 404'd them on the live site.
/Cards/
/Extras/
/Logos/
/Shows/

# Editor / OS noise
.DS_Store
Thumbs.db
*.local
.idea/
.vscode/

# Screenshots and scratch files
.playwright-mcp/
*.jpeg.tmp
